# CyberLens Security Posture Platform Environment Configuration
# Copy this file to .env and adjust variables as needed

# Django Security Settings
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Database Configuration (PostgreSQL by default when configured)
# To use SQLite for quick zero-setup testing, set USE_SQLITE=True
USE_SQLITE=True

# PostgreSQL Settings (when USE_SQLITE=False)
DB_ENGINE=postgresql
DB_NAME=cyberlens_db
DB_USER=cyberlens_user
DB_PASSWORD=cyberlens_secure_password
DB_HOST=localhost
DB_PORT=5432

# Scanner Engine Tuning
SCANNER_TIMEOUT=8
SCANNER_MAX_REDIRECTS=5
SCANNER_USER_AGENT=CyberLens-PostureAuditor/1.0 (+https://cyberlens.local/bot; Security Assessment)
